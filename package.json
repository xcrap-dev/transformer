{
  "name": "@xcrap/transformer",
  "version": "1.0.0",
  "description": "Xcrap Transformer is a set of ready-made Zod schemas to clean, convert and validate scraped data (prices, URLs, dates, numbers and more).",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint": "oxlint src __tests__",
    "lint:fix": "oxlint src __tests__ --fix"
  },
  "keywords": [
    "xcrap",
    "transformer",
    "scrapy",
    "web scraping"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/he": "^1.2.3",
    "@types/node": "24.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "he": "^1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xcrap-Cloud/transformer.git"
  },
  "bugs": {
    "url": "https://github.com/Xcrap-Cloud/transformer/issues"
  },
  "homepage": "https://github.com/Xcrap-Cloud/transformer#readme",
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
